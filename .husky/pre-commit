[ -n "$CI" ] && exit 0

export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

if ! command -v node >/dev/null 2>&1; then
  if [ -s "$HOME/.nvm/nvm.sh" ]; then
    . "$HOME/.nvm/nvm.sh"
    nvm use --silent >/dev/null 2>&1 || true
  fi
fi

if ! command -v node >/dev/null 2>&1 && [ -s "$HOME/.asdf/asdf.sh" ]; then
  . "$HOME/.asdf/asdf.sh"
fi

if ! command -v node >/dev/null 2>&1 && [ -d "$HOME/.volta/bin" ]; then
  export PATH="$HOME/.volta/bin:$PATH"
fi

if ! command -v node >/dev/null 2>&1; then
  echo "Error: node not found in PATH. Install Node.js or configure ~/.config/husky/init.sh"
  exit 1
fi

if [ -x "./node_modules/.bin/lint-staged" ]; then
  ./node_modules/.bin/lint-staged --config ./.husky/lint-staged.config.js
elif command -v npm >/dev/null 2>&1; then
  npm exec -- lint-staged --config ./.husky/lint-staged.config.js
else
  echo "Error: lint-staged not found. Run npm install first."
  exit 1
fi
